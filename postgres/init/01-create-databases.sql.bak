-- Conectar a la base de datos por defecto
\c postgres;

-- Crear bases de datos si no existen
DO $$
BEGIN
    IF NOT EXISTS (SELECT FROM pg_database WHERE datname = 'users_db') THEN
        PERFORM dblink_exec('dbname=' || current_database(), 'CREATE DATABASE users_db');
    END IF;
    IF NOT EXISTS (SELECT FROM pg_database WHERE datname = 'projects_db') THEN
        PERFORM dblink_exec('dbname=' || current_database(), 'CREATE DATABASE projects_db');
    END IF;
END
$$;